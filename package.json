{
	"name": "kiss",
	"version": "0.1.0",
	"private": true,
	"description": "Kontrollrammeverk for Integrert Sikker Systemutvikling",
	"type": "module",
	"engines": {
		"node": "^24.0.0"
	},
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"start": "node ./build/server/index.js",
		"typecheck": "react-router typegen && tsc",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check . && react-router typegen && tsc",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:int": "vitest run --config vitest.integration.config.ts",
		"test:all": "vitest run --project unit && STORYBOOK=true vitest run --project storybook && vitest run --config vitest.integration.config.ts",
		"test:coverage": "vitest run --project unit --coverage",
		"storybook": "STORYBOOK=true storybook dev -p 6006",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:stories": "STORYBOOK=true vitest --project storybook",
		"build-storybook": "STORYBOOK=true storybook build",
		"capture-screenshots": "npx tsx scripts/capture-screenshots.ts",
		"capture-docs-screenshots": "npx tsx scripts/capture-screenshots.ts --docs",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:seed": "tsx app/db/seed.ts",
		"dev:setup": "docker-compose up -d && pnpm db:push",
		"dev:setup:postgresapp": "pnpm db:create:postgresapp && pnpm db:push",
		"db:create:postgresapp": "createdb kiss 2>/dev/null || true"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@google-cloud/storage": "^8.0.1",
		"@navikt/aksel-icons": "^8.16.1",
		"@navikt/ds-css": "^8.16.1",
		"@navikt/ds-react": "^8.16.1",
		"@opentelemetry/api": "^1.9.1",
		"@react-router/express": "^8.3.0",
		"@react-router/node": "^8.3.0",
		"@react-router/serve": "^8.3.0",
		"archiver": "^8.0.0",
		"compression": "^1.8.1",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"isbot": "^5.2.1",
		"isomorphic-dompurify": "^3.22.0",
		"jose": "^6.2.10",
		"jszip": "^3.10.1",
		"marked": "^18.0.11",
		"mime-types": "^3.0.2",
		"pdf-lib": "^1.17.1",
		"pdfkit": "^0.20.1",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0",
		"winston": "^3.19.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.11",
		"@playwright/test": "^1.62.1",
		"@react-router/dev": "^8.3.0",
		"@storybook/addon-vitest": "^10.5.10",
		"@storybook/react": "^10.5.10",
		"@storybook/react-vite": "^10.5.10",
		"@testcontainers/postgresql": "^12.1.0",
		"@testing-library/react": "^16.3.2",
		"@types/archiver": "^8.0.0",
		"@types/compression": "^1.8.1",
		"@types/express": "^5.0.6",
		"@types/jszip": "^3.4.1",
		"@types/mime-types": "^3.0.1",
		"@types/node": "^24.13.3",
		"@types/pdfkit": "^0.17.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitest/browser-playwright": "^4.1.11",
		"@vitest/coverage-v8": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^30.0.1",
		"knip": "^6.32.3",
		"lefthook": "^2.1.10",
		"playwright": "^1.62.1",
		"storybook": "^10.5.10",
		"testcontainers": "^12.1.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
